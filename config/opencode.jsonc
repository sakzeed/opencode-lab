{
  "$schema": "https://opencode.ai/config.json",

  // โมเดลเริ่มต้นสำหรับทุก session (รูปแบบ provider/model)
  "model": "opencode/big-pickle",

  // กฎสิทธิ์: ใช้ "กฎสุดท้ายที่ตรง" ชนะ (last match wins)
  // ลำดับจึงสำคัญมาก — กฎเฉพาะต้องอยู่หลังกฎกว้าง
  "permissions": [
    // ── ข้อมูลลับ: ถามก่อนอ่าน ──────────────────────────────
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*id_rsa*", "effect": "ask" },

    // ── ทำลายข้อมูลได้: ถามทุกครั้ง ─────────────────────────
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm -fr *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "chmod -R 777 *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },

    // ── อันตรายถึงระบบ: บล็อกเลย ────────────────────────────
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "curl * | sh*", "effect": "deny" },
    { "action": "shell", "resource": "wget * | sh*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown *", "effect": "deny" },
    { "action": "shell", "resource": "reboot *", "effect": "deny" },

    // ── ห้ามแก้ไฟล์ภายใน .git ───────────────────────────────
    { "action": "edit", "resource": "*.git/*", "effect": "deny" },

    // ── นอกโปรเจกต์: ถาม ยกเว้นโฟลเดอร์ระบบที่อ่านบ่อย ──────
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/etc/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/proc/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/sys/*", "effect": "allow" },
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
}
